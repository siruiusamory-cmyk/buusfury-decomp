---
import {
  buildoutDone,
  buildoutTotal,
  buildoutPercent,
  roadmap,
  roadmapStateLabel,
  roadmapStateGlyph,
} from "../data/project";

// The public roadmap to 1.0. Order and wording come from the roadmap data, and
// every count is accumulated from the capability registry, so this section can
// never disagree with the capability list above it. State is carried by a glyph
// and a text label as well as a colour, never by colour alone.
---

<section class="to-one" id="roadmap-to-1-0" aria-labelledby="to-one-title">
  <div class="shell">
    <div class="panel to-one-panel">
      <div class="panel-head">
        <div>
          <p class="kicker">ROADMAP TO 1.0</p>
          <h2 id="to-one-title">{roadmap.title}</h2>
        </div>
        <p class="to-one-position">
          <span class="kicker">CURRENT</span>
          <b class="to-one-count">{buildoutDone} / {buildoutTotal}</b>
          <span class="to-one-pct">{buildoutPercent}%</span>
        </p>
      </div>

      <p class="to-one-lede">{roadmap.lede}</p>
      <p class="to-one-where">{roadmap.position}</p>

      <ol class="phases">
        {roadmap.phases.map((phase) => (
          <li class:list={["phase", `is-${phase.state}`]}>
            <div class="phase-head">
              <span class="phase-glyph" aria-hidden="true">{roadmapStateGlyph[phase.state]}</span>
              <span class="phase-n" aria-hidden="true">{phase.ordinal}</span>
              <span class="phase-heading">
                <span class="phase-kicker">PHASE {phase.ordinal}</span>
                <b class="phase-title">{phase.title}</b>
              </span>
              <span class="phase-right">
                <span class="phase-state">{roadmapStateLabel[phase.state]}</span>
                <span class="phase-count">{phase.done} / {buildoutTotal}</span>
              </span>
            </div>

            <p class="phase-summary">{phase.summary}</p>

            {phase.outcomes.length > 0 && (
              <ol class="outcomes">
                {phase.outcomes.map((outcome, index) => (
                  <li class="outcome">
                    <span class="outcome-mark" aria-hidden="true">→</span>
                    <span class="outcome-body">
                      <b>{outcome.title}</b>
                      <small>{outcome.detail}</small>
                    </span>
                    <span class="outcome-count">{phase.outcomeTotals[index]} / {buildoutTotal}</span>
                  </li>
                ))}
              </ol>
            )}

            {phase.work.length > 0 && (
              <ul class="phase-work">
                {phase.work.map((item) => <li>{item}</li>)}
              </ul>
            )}

            {phase.done === buildoutTotal && phase.outcomes.length > 0 && (
              <p class="phase-flag">100% FEATURE COMPLETE</p>
            )}

            {phase.state === "next" && (
              <p class="phase-marker">YOU ARE HERE · this phase has not started</p>
            )}
          </li>
        ))}
      </ol>

      <div class="to-one-notes">
        <div class="to-one-note">
          <p class="kicker">FEATURE COMPLETE</p>
          <h3>{roadmap.featureCompleteTitle}</h3>
          <p>{roadmap.featureComplete}</p>
        </div>
        <div class="to-one-note">
          <p class="kicker">1.0</p>
          <h3>{roadmap.releaseTitle}</h3>
          <p>{roadmap.releaseGate}</p>
        </div>
        <div class="to-one-note is-golden">
          <p class="kicker">FINAL ACCEPTANCE</p>
          <h3>{roadmap.goldenTitle}</h3>
          <p>{roadmap.goldenProject}</p>
        </div>
      </div>
    </div>
  </div>
</section>
