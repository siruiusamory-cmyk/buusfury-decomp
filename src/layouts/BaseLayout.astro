---
import "../styles/global.css";
import { project, buildoutDone, buildoutTotal, buildoutPercent } from "../data/project";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${project.name} — ${project.currentPhase} progress`,
  description =
    `Webfoot SDK is a modding toolkit and desktop editor for the Webfoot Dragon Ball Z GBA games.` +
    ` DragonByte Z Buildout: ${buildoutDone} of ${buildoutTotal} editor capabilities shipped (${buildoutPercent}%).` +
    ` The authoring programme that built the toolkit is complete.`,
} = Astro.props;

const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const preview = site
  ? new URL(`${import.meta.env.BASE_URL}dbz-map-browser.png`, site).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f9d3e5" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={project.name} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {preview && <meta property="og:image" content={preview} />}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body style={`--wallpaper: url("${import.meta.env.BASE_URL}aero-sky.svg")`}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <svg class="sprite" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="g-gel" cx="0.4" cy="0.3" r="0.75">
          <stop offset="0" stop-color="#f9b6d4" />
          <stop offset="0.55" stop-color="#d23f86" />
          <stop offset="1" stop-color="#7d1046" />
        </radialGradient>
        <radialGradient id="g-glass" cx="0.4" cy="0.3" r="0.75">
          <stop offset="0" stop-color="#ffffff" />
          <stop offset="1" stop-color="#f1cfe0" />
        </radialGradient>
        <radialGradient id="g-gold" cx="0.4" cy="0.3" r="0.8">
          <stop offset="0" stop-color="#ffe9a8" />
          <stop offset="0.6" stop-color="#e6a52a" />
          <stop offset="1" stop-color="#8a4a00" />
        </radialGradient>
        <linearGradient id="g-folder" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" />
          <stop offset="0.5" stop-color="#fbe1ee" />
          <stop offset="0.5" stop-color="#f4c4dc" />
          <stop offset="1" stop-color="#e9a3c6" />
        </linearGradient>
        <linearGradient id="g-shine" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.95" />
          <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
        </linearGradient>
      </defs>
      <symbol id="i-done" viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="7" fill="url(#g-gel)" stroke="#6d0c3c" stroke-width="0.6" />
        <ellipse cx="8" cy="5" rx="4.6" ry="2.8" fill="url(#g-shine)" />
        <path d="M4.6 8.3 7 10.6 11.6 5.6" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </symbol>
      <symbol id="i-live" viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="7" fill="url(#g-gel)" stroke="#6d0c3c" stroke-width="0.6" />
        <ellipse cx="8" cy="5" rx="4.6" ry="2.8" fill="url(#g-shine)" />
        <path d="M6.3 4.9v6.2L11.2 8z" fill="#fff" />
      </symbol>
      <symbol id="i-next" viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="7" fill="url(#g-glass)" stroke="#a81560" stroke-width="1.2" />
        <ellipse cx="8" cy="5" rx="4.6" ry="2.8" fill="url(#g-shine)" />
        <path d="M5 8h5.2M8.2 5.6 10.6 8l-2.4 2.4" fill="none" stroke="#a81560" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </symbol>
      <symbol id="i-todo" viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="7" fill="url(#g-glass)" stroke="#b57a97" stroke-width="0.8" />
        <ellipse cx="8" cy="5" rx="4.6" ry="2.8" fill="url(#g-shine)" />
      </symbol>
      <symbol id="i-target" viewBox="0 0 16 16">
        <path d="M8 1.2l2.1 4.3 4.7.7-3.4 3.3.8 4.7L8 12l-4.2 2.2.8-4.7L1.2 6.2l4.7-.7z" fill="url(#g-gold)" stroke="#6b3a00" stroke-width="0.6" stroke-linejoin="round" />
        <path d="M8 2.6l1.5 3.1L6.5 6z" fill="#fff" opacity="0.7" />
      </symbol>
      <symbol id="i-folder" viewBox="0 0 16 16">
        <path d="M1.5 3.5h4.6l1.5 1.6h6.9v8.4h-13z" fill="url(#g-folder)" stroke="#a8517d" stroke-width="0.7" stroke-linejoin="round" />
        <path d="M1.9 6.2h12.2" stroke="#fff" stroke-width="0.8" />
      </symbol>
      <symbol id="i-folder-new" viewBox="0 0 16 16">
        <use href="#i-folder" />
        <circle cx="12.4" cy="11.4" r="3.1" fill="url(#g-gel)" stroke="#fff" stroke-width="0.8" />
      </symbol>
      <symbol id="i-announce" viewBox="0 0 16 16">
        <use href="#i-folder" />
        <circle cx="12.2" cy="11.2" r="3.3" fill="url(#g-gold)" stroke="#fff" stroke-width="0.8" />
        <path d="M12.2 9.4v1.9" stroke="#4a2600" stroke-width="1.1" stroke-linecap="round" />
        <circle cx="12.2" cy="12.9" r="0.6" fill="#4a2600" />
      </symbol>
      <symbol id="i-logo" viewBox="0 0 32 32">
        <circle cx="16" cy="16" r="15" fill="url(#g-gel)" stroke="#6d0c3c" stroke-width="0.8" />
        <ellipse cx="16" cy="10" rx="10" ry="6" fill="url(#g-shine)" />
        <path d="M6.8 12.5 9 21l2.6-6.4L14.2 21l2.2-8.5M19.2 21v-8.5h5.6M19.2 16.6h4.4" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
      </symbol>
    </svg>
    <slot />
  </body>
</html>
