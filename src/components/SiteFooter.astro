---
import { project } from "../data/project";
import Window from "./Window.astro";

const links = project.links.filter((link) => link.url);
---

<Window id="readme" title="readme.txt - Notepad" icon="folder" as="footer" label="About this site" class="notepad">
  <div class="notepad-menu" aria-hidden="true"><span>File</span><span>Edit</span><span>Format</span><span>View</span><span>Help</span></div>
  <div class="notepad-page">
    <p><b>{project.name}</b></p>
    <p>{project.footerTagline}</p>
    <p>Status: {project.developmentStatus}</p>
    {links.length > 0 && (
      <ul class="notepad-links">
        {links.map((link) => <li><a href={link.url} rel="noopener">{link.label}</a></li>)}
      </ul>
    )}
    <p>{project.disclaimer}</p>
    <p>{project.assetPolicy}</p>
  </div>
</Window>
