# Commercial ROM images
roms/
*.gba
*.gb
*.gbc
*.sav
*.srm
*.mss
*.ss?
*.state

# Extracted/generated game data
extracted/
dump/
dumps/
stock/
exports/
*.bin
*.dump
*.raw

# Extracted graphics (TOOLKIT-010). Project extraction writes one indexed PNG
# per sprite payload; those pixels are the publisher's artwork, so they are
# project OUTPUT and are never committed, wherever a project happens to sit.
graphics/assets/
**/graphics/assets/

# Generated builds
build/
dist/
node_modules/
.astro/
*.egg-info/
*.spec

# External upstream repositories
extern/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Local workflow-hook state
<tool-state>/

# Private agent/session workflow residue. These are local working notes, not
# project history, and must never reach the public repository.
/<working-notes>.md
/<workflow-state>/
/<working-notes>/

# local tool runtime state
<tool-state>/goals/
<tool-state>/workflow-steps/
<tool-state>/workflow-locks/

# Superseded one-off workflow migration prompt
/<working-notes>.txt

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
