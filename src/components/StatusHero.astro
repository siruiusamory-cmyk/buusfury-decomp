---
import { project } from "../data/project";
import ProgressMeter from "./ProgressMeter.astro";
---

<section class="hero panel" id="status" aria-labelledby="status-title">
  <div class="hero-main">
    <p class="eyebrow">PROJECT STATUS / 240 × 160</p>
    <h1 id="status-title">{project.name}</h1>
    <p class="hero-tagline">{project.tagline}</p>
    <ProgressMeter value={project.overallProgress} label={project.overallProgressLabel} caveat={project.progressCaveat} />
    <p class="hero-description">{project.description}</p>
  </div>
  <div class="hero-console" aria-label="Current project state">
    <div class="console-header"><span>AUTHORING STATE</span><span class="signal">LIVE</span></div>
    <dl class="status-fields">
      <div>
        <dt>EXISTING CONTENT</dt>
        <dd class="complete-text">✓ {project.existingContentState}</dd>
      </div>
      <div class="active-field">
        <dt>{project.currentPhase}</dt>
        <dd>◆ {project.currentFrontierLabel}</dd>
      </div>
    </dl>
    <div class="blocker-readout">
      <p class="eyebrow">CURRENT BLOCKER</p>
      <h2>{project.blockerCode}</h2>
      <p>{project.blockerShort}</p>
    </div>
  </div>
</section>
