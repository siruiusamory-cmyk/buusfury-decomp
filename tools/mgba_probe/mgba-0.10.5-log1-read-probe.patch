+M_TEST_DEFINE(log1ProbeReadValueUnchangedAndNonCpuIgnored) {
+	struct ProbeFixture fixture = _probeFixtureCreate();
+	struct GBALog1ReadProbeRequest request = _probeRequest(1);
+	assert_true(GBALog1ReadProbeArm(fixture.gba, &request));
+	fixture.gba->memory.wram[(request.target + 4 - BASE_WORKING_RAM) / 4] = 0xA1B2C3D4;
+	uint32_t value = GBALoad32(fixture.cpu, request.target + 4, NULL);
+	assert_int_equal(value, 0xA1B2C3D4);
+	struct GBALog1ReadProbeEvent event;
+	assert_false(GBALog1ReadProbeGetEvent(fixture.gba, &event));
+	int cycles = 0;
+	value = GBALoad32(fixture.cpu, request.target + 4, &cycles);
+	assert_int_equal(value, 0xA1B2C3D4);
+	assert_true(GBALog1ReadProbeGetEvent(fixture.gba, &event));
+	_probeFixtureDestroy(&fixture);
+}
