; Engine configuration file.
; VS-001 combat vertical slice. Godot 4.7-beta5.

config_version=5

[application]

config/name="LOG1 Remake — VS-001 Combat Slice"
; scenes/test_room.tscn is owned by another module and does not exist yet at
; tier 0; a missing-main-scene complaint on a headless launch is expected.
run/main_scene="res://scenes/test_room.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

; Order matters: Clock must exist before anything subscribes to it.
Clock="*res://core/tick_clock.gd"
EventLog="*res://core/event_log.gd"
Party="*res://progression/party.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/stretch/mode="canvas_items"

[physics]

; The clock re-asserts these at runtime; they are set here so the very first
; frame already runs at the gameplay rate.
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
