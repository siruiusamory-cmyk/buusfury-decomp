---
import {
  buildoutDone,
  buildoutTotal,
  buildoutPercent,
  roadmap,
  roadmapStateLabel,
  roadmapWorkItem,
} from "../data/project";
import type { RoadmapPhaseView, RoadmapPhaseState } from "../data/project";
import Icon from "./Icon.astro";
import Window from "./Window.astro";

const phaseCount = (phase: RoadmapPhaseView) =>
  phase.outcomes.length > 0 ? `${phase.done} / ${buildoutTotal}` : "&mdash;";

const workItem = (text: string, phaseComplete: boolean) => {
  const item = roadmapWorkItem(text);
  return { ...item, done: item.shipped || phaseComplete };
};

const phaseIcon: Record<RoadmapPhaseState, "done" | "live" | "next" | "todo"> = {
  complete: "done",
  "in-progress": "live",
  next: "next",
  planned: "todo",
};
---

<Window id="roadmap-to-1-0" title="Roadmap to 1.0 - DragonByte Z Forums" icon="next" labelledby="to-one-title" class="forum-window to-one">
  <div class="th">
    <h2 id="to-one-title">Thread: {roadmap.title}</h2>
    <span class="th-aside">Current: <b class="to-one-count">{buildoutDone} / {buildoutTotal}</b> <span class="to-one-pct">{buildoutPercent}%</span></span>
  </div>

  <div class="thread-intro row1">
    <p class="to-one-lede">{roadmap.lede}</p>
    <p class="to-one-where">{roadmap.position}</p>
  </div>

  <ol class="phases">
    {roadmap.phases.map((phase) => (
      <li class:list={["phase", "post", `is-${phase.state}`]}>
        <div class="postbit">
          <Icon name={phaseIcon[phase.state]} class="postbit-icon" />
          <span class="phase-kicker">Phase {phase.ordinal}</span>
          <span class="phase-state">{roadmapStateLabel[phase.state]}</span>
          <span class="phase-count" set:html={phaseCount(phase)} />
        </div>

        <div class="post-body">
          <h3 class="phase-title">{phase.title}</h3>
          <p class="phase-summary">{phase.summary}</p>

          {phase.outcomes.length > 0 && (
            <ol class="outcomes">
              {phase.outcomes.map((outcome, index) => (
                <li class="outcome">
                  <Icon name="todo" class="outcome-icon" />
                  <span class="outcome-body">
                    <b>{outcome.title}</b>
                    <small>{outcome.detail}</small>
                  </span>
                  <span class="outcome-count">{phase.outcomeTotals[index]} / {buildoutTotal}</span>
                </li>
              ))}
            </ol>
          )}

          {phase.work.length > 0 && (
            <ul class="phase-work">
              {phase.work.map((text) => workItem(text, phase.state === "complete")).map((item) => (
                <li class:list={["work-item", item.done ? "is-done" : "is-todo"]}>
                  <Icon name={item.done ? "done" : "todo"} class="work-icon" />
                  <span class="work-body">
                    <b>{item.name}</b>
                    {item.detail && <small>{item.detail}</small>}
                  </span>
                  {item.shipped && <span class="chip chip-shipped">SHIPPED</span>}
                </li>
              ))}
            </ul>
          )}

          {phase.done === buildoutTotal && phase.outcomes.length > 0 && (
            <p class="phase-flag">100% feature complete</p>
          )}

          {phase.state === "in-progress" && (
            <p class="phase-marker">You are here: this phase is in progress</p>
          )}

          {phase.state === "next" && (
            <p class="phase-marker">You are here: this phase has not started</p>
          )}
        </div>
      </li>
    ))}
  </ol>

  <div class="to-one-notes">
    <div class="to-one-note">
      <Icon name="folder" class="note-icon" />
      <h3>{roadmap.featureCompleteTitle}</h3>
      <p>{roadmap.featureComplete}</p>
    </div>
    <div class="to-one-note">
      <Icon name="folder" class="note-icon" />
      <h3>{roadmap.releaseTitle}</h3>
      <p>{roadmap.releaseGate}</p>
    </div>
    <div class="to-one-note is-golden">
      <Icon name="target" class="note-icon" />
      <h3>{roadmap.goldenTitle}</h3>
      <p>{roadmap.goldenProject}</p>
    </div>
  </div>
</Window>
