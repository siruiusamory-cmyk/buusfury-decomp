+	fixture.cpu->gprs[ARM_PC] = 0x0801277E;
+	GBALog1ReadProbeObserve(fixture.gba, fixture.cpu, request.target + 4, 2, &cycles);
+	assert_false(GBALog1ReadProbeGetEvent(fixture.gba, &event));
+	GBALog1ReadProbeObserve(fixture.gba, fixture.cpu, request.target + 0x0D, 4, &cycles);
+	assert_true(GBALog1ReadProbeGetEvent(fixture.gba, &event));
+	assert_int_equal(event.instructionPc, 0x0801277A);
+	assert_int_equal(event.overlapStart, request.target + 0x0C);
+	assert_int_equal(event.overlapEnd, request.target + 0x10);
+	_probeFixtureDestroy(&fixture);
+}
