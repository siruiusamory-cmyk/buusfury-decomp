---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProgressStrip from "../components/ProgressStrip.astro";
import MainBand from "../components/MainBand.astro";
import RoadmapTo1 from "../components/RoadmapTo1.astro";
import ProofBand from "../components/ProofBand.astro";
import SiteFooter from "../components/SiteFooter.astro";
import DesktopIcons from "../components/DesktopIcons.astro";
import Gadgets from "../components/Gadgets.astro";
import Taskbar from "../components/Taskbar.astro";
---

<BaseLayout>
  <div id="top"></div>
  <div class="desktop">
    <DesktopIcons />
    <main id="main-content" class="windows">
      <Hero />
      <ProgressStrip />
      <MainBand />
      <RoadmapTo1 />
      <ProofBand />
    </main>
    <Gadgets />
    <SiteFooter />
  </div>
  <Taskbar />
</BaseLayout>
