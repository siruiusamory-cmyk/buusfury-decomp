+void GBALog1ReadProbeReset(struct GBA* gba) {
+	memset(&gba->log1ReadProbe, 0, sizeof(gba->log1ReadProbe));
+	gba->log1ReadProbe.nextEventId = 1;
+}
+
+bool GBALog1ReadProbeArm(struct GBA* gba, const struct GBALog1ReadProbeRequest* request) {
+	struct GBALog1ReadProbe* probe = &gba->log1ReadProbe;
+	if (!request || probe->captured || request->sequence <= probe->lastSequence || !request->loadEpoch) {
+		return false;
+	}
+	if (request->factoryRaw != 0x08007675 || request->factoryFetch != 0x08007674) {
+		return false;
+	}
+	if (request->matchKind > GBA_LOG1_READ_PROBE_ACCEPTED_X0C) {
+		return false;
+	}
+	if (request->target < BASE_WORKING_RAM || request->target > BASE_WORKING_RAM + SIZE_WORKING_RAM - 0x18) {
+		return false;
+	}
+	probe->request = *request;
+	probe->lastSequence = request->sequence;
+	probe->captured = false;
+	probe->armed = true;
+	return true;
+}
+
+bool GBALog1ReadProbeDisarm(struct GBA* gba, uint64_t sequence) {
+	struct GBALog1ReadProbe* probe = &gba->log1ReadProbe;
+	if (!probe->armed || probe->request.sequence != sequence) {
+		return false;
+	}
+	probe->armed = false;
+	return true;
+}
+
+bool GBALog1ReadProbeGetEvent(const struct GBA* gba, struct GBALog1ReadProbeEvent* event) {
+	const struct GBALog1ReadProbe* probe = &gba->log1ReadProbe;
+	if (!probe->captured || !event) {
+		return false;
+	}
+	*event = probe->event;
+	return true;
+}
+
+bool GBALog1ReadProbeAcknowledgeEvent(struct GBA* gba, uint64_t eventId) {
+	struct GBALog1ReadProbe* probe = &gba->log1ReadProbe;
+	if (!probe->captured || probe->event.eventId != eventId) {
+		return false;
+	}
+	probe->captured = false;
+	return true;
+}
+
+static bool _log1Overlaps(uint32_t start, uint32_t width, uint32_t rangeStart, uint32_t rangeEnd, uint32_t* overlapStart, uint32_t* overlapEnd) {
+	uint64_t end = (uint64_t) start + width;
+	if (!width || start >= rangeEnd || rangeStart >= end) {
+		return false;
+	}
+	*overlapStart = start > rangeStart ? start : rangeStart;
+	*overlapEnd = end < rangeEnd ? (uint32_t) end : rangeEnd;
+	return true;
+}
+
+void GBALog1ReadProbeObserve(struct GBA* gba, struct ARMCore* cpu, uint32_t address, uint32_t width, const int* cycleCounter) {
+	struct GBALog1ReadProbe* probe = &gba->log1ReadProbe;
+	if (LIKELY(!probe->armed) || !cycleCounter || gba->performingDMA) {
+		return;
+	}
+	uint32_t overlapStart;
+	uint32_t overlapEnd;
+	uint32_t physicalAddress = width == 4 ? address & ~3U : width == 2 ? address & ~1U : address;
+	uint32_t instructionPc = _ARMPCAddress(cpu);
+	bool matched = false;
+	if (probe->request.matchKind == GBA_LOG1_READ_PROBE_ACCEPTED_X0C) {
+		matched = instructionPc == 0x0801277A &&
+		    _log1Overlaps(physicalAddress, width, probe->request.target + 0x0C, probe->request.target + 0x10, &overlapStart, &overlapEnd);
+	} else {
+		matched = _log1Overlaps(physicalAddress, width, probe->request.target + 0x04, probe->request.target + 0x10, &overlapStart, &overlapEnd) ||
+		    _log1Overlaps(physicalAddress, width, probe->request.target + 0x14, probe->request.target + 0x18, &overlapStart, &overlapEnd);
+	}
+	if (!matched) {
+		return;
+	}
+	uint32_t target = probe->request.target;
+	struct GBALog1ReadProbeEvent* event = &probe->event;
+	memset(event, 0, sizeof(*event));
+	event->eventId = probe->nextEventId++;
+	event->sequence = probe->request.sequence;
+	event->target = target;
+	event->loadEpoch = probe->request.loadEpoch;
+	event->descriptor = probe->request.descriptor;
+	event->factoryRaw = probe->request.factoryRaw;
+	event->factoryFetch = probe->request.factoryFetch;
+	event->address = address;
+	event->relativeOffset = (int32_t) (address - target);
+	event->width = width;
+	event->overlapStart = overlapStart;
+	event->overlapEnd = overlapEnd;
+	event->instructionPc = instructionPc;
+	memcpy(event->gprs, cpu->gprs, sizeof(event->gprs));
+	event->cpsr = cpu->cpsr.packed;
+	probe->armed = false;
+	probe->captured = true;
+#ifdef USE_DEBUGGERS
+	if (gba->debugger) {
+		struct mDebuggerEntryInfo info = {
+			.address = address,
+			.type.wp.watchType = WATCHPOINT_READ,
+		};
+		mDebuggerEnter(gba->debugger->d.p, DEBUGGER_ENTER_WATCHPOINT, &info);
+	}
+#endif
+}
