+M_TEST_DEFINE(log1ProbeUnalignedPhysicalSpanControlsOverlap) {
+	struct ProbeFixture fixture = _probeFixtureCreate();
+	struct GBALog1ReadProbeRequest request = _probeRequest(1);
+	assert_true(GBALog1ReadProbeArm(fixture.gba, &request));
+	int cycles = 0;
+	GBALog1ReadProbeObserve(fixture.gba, fixture.cpu, request.target + 2, 4, &cycles);
+	struct GBALog1ReadProbeEvent event;
+	assert_false(GBALog1ReadProbeGetEvent(fixture.gba, &event));
+	GBALog1ReadProbeObserve(fixture.gba, fixture.cpu, request.target + 5, 4, &cycles);
+	assert_true(GBALog1ReadProbeGetEvent(fixture.gba, &event));
+	assert_int_equal(event.address, request.target + 5);
+	assert_int_equal(event.width, 4);
+	assert_int_equal(event.overlapStart, request.target + 4);
+	assert_int_equal(event.overlapEnd, request.target + 8);
+	assert_true(GBALog1ReadProbeAcknowledgeEvent(fixture.gba, event.eventId));
+	request.sequence = 2;
+	assert_true(GBALog1ReadProbeArm(fixture.gba, &request));
+	GBALog1ReadProbeObserve(fixture.gba, fixture.cpu, request.target + 3, 2, &cycles);
+	assert_false(GBALog1ReadProbeGetEvent(fixture.gba, &event));
+	GBALog1ReadProbeObserve(fixture.gba, fixture.cpu, request.target + 5, 2, &cycles);
+	assert_true(GBALog1ReadProbeGetEvent(fixture.gba, &event));
+	assert_int_equal(event.address, request.target + 5);
+	assert_int_equal(event.width, 2);
+	assert_int_equal(event.overlapStart, request.target + 4);
+	assert_int_equal(event.overlapEnd, request.target + 6);
+	_probeFixtureDestroy(&fixture);
+}
