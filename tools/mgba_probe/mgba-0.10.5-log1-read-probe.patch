+M_TEST_DEFINE(log1ProbeCapturesOnceAndDisarms) {
+	struct ProbeFixture fixture = _probeFixtureCreate();
+	struct GBALog1ReadProbeRequest request = _probeRequest(1);
+	assert_true(GBALog1ReadProbeArm(fixture.gba, &request));
+	int cycles = 0;
+	GBALog1ReadProbeObserve(fixture.gba, fixture.cpu, request.target + 4, 2, &cycles);
+	struct GBALog1ReadProbeEvent first;
+	assert_true(GBALog1ReadProbeGetEvent(fixture.gba, &first));
+	assert_false(fixture.gba->log1ReadProbe.armed);
+	assert_int_equal(first.address, request.target + 4);
+	assert_int_equal(first.relativeOffset, 4);
+	assert_int_equal(first.width, 2);
+	assert_int_equal(first.instructionPc, 0x08001000);
+	assert_int_equal(first.gprs[ARM_LR], 0x08002001);
+	GBALog1ReadProbeObserve(fixture.gba, fixture.cpu, request.target + 0x14, 4, &cycles);
+	struct GBALog1ReadProbeEvent second;
+	assert_true(GBALog1ReadProbeGetEvent(fixture.gba, &second));
+	assert_int_equal(second.eventId, first.eventId);
+	request.sequence = 2;
+	assert_false(GBALog1ReadProbeArm(fixture.gba, &request));
+	assert_true(GBALog1ReadProbeAcknowledgeEvent(fixture.gba, first.eventId));
+	assert_false(GBALog1ReadProbeGetEvent(fixture.gba, &second));
+	_probeFixtureDestroy(&fixture);
+}
