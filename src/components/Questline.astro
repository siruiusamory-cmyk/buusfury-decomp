---
import { project, statusMeta } from "../data/project";
import type { MilestoneStatus } from "../data/project";
import Icon from "./Icon.astro";

const milestones = project.milestones;
const spans = Math.max(milestones.length - 1, 1);
const at = (nodeIndex: number) =>
  `${((Math.min(Math.max(nodeIndex, 0), spans) / spans) * 100).toFixed(2)}%`;

const lastIndexOf = (wanted: string) =>
  milestones.reduce((found, { status }, i) => (status === wanted ? i : found), -1);

const lastComplete = lastIndexOf("complete");
const lastCurrent = lastIndexOf("current");
const firstTarget = milestones.findIndex(({ status }) => status === "target");

const railStyle = [
  `--rail-complete: ${at(lastComplete)}`,
  `--rail-current: ${at(Math.max(lastCurrent, lastComplete))}`,
  `--rail-target: ${at(firstTarget === -1 ? spans : firstTarget)}`,
].join("; ");

const questIcon: Record<MilestoneStatus, "done" | "live" | "next" | "target"> = {
  complete: "done",
  current: "live",
  next: "next",
  target: "target",
};
---

<ol class="questline" style={railStyle}>
  {milestones.map((milestone) => (
    <li class:list={["quest", `is-${milestone.status}`]}>
      <Icon name={questIcon[milestone.status]} class="quest-node" />
      <article>
        <p class="quest-status">{statusMeta[milestone.status].label}</p>
        <h3>{milestone.title}</h3>
        <p>{milestone.plainEnglish}</p>
        {milestone.technical && <p class="quest-tech">{milestone.technical}</p>}
        {milestone.openItems?.map((item) => (
          <p class="quest-open"><b>Still open:</b> {item}</p>
        ))}
      </article>
    </li>
  ))}
</ol>
