---
import {
  project,
  buildoutDone,
  buildoutTotal,
  roadmapRows,
  familyTallies,
  recentBreakthroughs,
  archivedBreakthroughs,
} from "../data/project";
import type { DependencyStep, FrontierStep } from "../data/project";
import Questline from "./Questline.astro";
import Icon from "./Icon.astro";
import Window from "./Window.astro";

const pad = (n: number) => String(n).padStart(2, "0");
const latest = recentBreakthroughs.slice(0, 4);
const rest = [...recentBreakthroughs.slice(4), ...archivedBreakthroughs];
const shot = project.figures[1];

const numbered = roadmapRows.map((row, index) => ({ ...row, n: pad(index + 1) }));
const families = familyTallies.map((family) => ({
  ...family,
  rows: numbered.filter((row) => row.family === family.label),
}));

const ladderIcon: Record<DependencyStep["state"], "done" | "live" | "next" | "target"> = {
  done: "done",
  current: "live",
  next: "next",
  target: "target",
};

const frontierLabel: Record<FrontierStep["kind"], string> = {
  near: "Next",
  gated: "Gated",
  horizon: "Horizon",
};
---

<div class="board-group">
  <Window id="focus" title="Announcements - DragonByte Z Forums" icon="announce" labelledby="focus-title" class="forum-window focus-panel">
    <div class="th">
      <h2 id="focus-title">Pinned announcement</h2>
      <span class="chip-live">In progress</span>
    </div>

    <div class="announce row1">
      <Icon name="announce" class="topic-icon" />
      <div class="announce-body">
        <h3><span class="prefix">Sticky:</span> {project.blockerTitle}</h3>
        <p class="focus-copy">{project.blockerShort}</p>
      </div>
      <figure class="focus-shot">
        <img
          src={`${import.meta.env.BASE_URL}${shot.src}`}
          width={shot.width}
          height={shot.height}
          alt={shot.alt}
          loading="lazy"
          decoding="async"
        />
        <figcaption><b>{shot.title}</b> {shot.facts[0]}</figcaption>
      </figure>
    </div>

    <ol class="frontier">
      {project.frontier.map((step) => (
        <li class:list={["topic", `is-${step.kind}`]}>
          <Icon name={step.kind === "horizon" ? "target" : "folder-new"} class="topic-icon" />
          <span class="topic-body">
            <b><span class="prefix">{frontierLabel[step.kind]}:</span> {step.title}</b>
            <small>{step.detail}</small>
          </span>
        </li>
      ))}
    </ol>

    <details class="more">
      <summary>More on the current blocker</summary>
      <div class="disclosure-body">
        {project.blockerParagraphs.map((paragraph) => <p class="focus-note">{paragraph}</p>)}
      </div>
    </details>
  </Window>

  <Window id="roadmap" title="Capability index - DragonByte Z Forums" icon="folder" labelledby="roadmap-title" class="forum-window roadmap-panel">
    <div class="th">
      <h2 id="roadmap-title">Capability index</h2>
      <span class="th-aside">{buildoutDone} / {buildoutTotal} SHIPPED</span>
    </div>
    <div class="cols cols-cap" aria-hidden="true">
      <span></span><span>Capability</span><span>Status</span>
    </div>

    <ul class="families">
      {families.map((family) => (
        <li class:list={[family.done === family.total ? "is-complete" : "is-partial"]} title={family.title}>
          <span>{family.label}</span>
          <b>{family.done}/{family.total}</b>
          <span class="cat-title">{family.title}</span>
          <ol class="rows">
            {family.rows.map((row) => (
              <li class:list={["row", row.state === "shipped" ? "is-done" : "is-todo"]} data-capability={row.key}>
                <Icon name={row.state === "shipped" ? "done" : "todo"} class="row-icon" />
                <details class="row-name toggle">
                  <summary><b>{row.n}. {row.title}</b></summary>
                  <small>{row.detail}</small>
                </details>
                <span class="chip">{row.state === "shipped" ? "DONE" : "PLANNED"}</span>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ul>

    <details class="more">
      <summary>The completed programme in full</summary>
      <div class="disclosure-body">
        <Questline />
        <ol class="ladder" aria-label="Authoring dependency ladder">
          {project.dependencyLadder.map((step) => (
            <li class:list={[`is-${step.state}`]}>
              <Icon name={ladderIcon[step.state]} class="ladder-icon" />
              <span class="label">
                {step.label}
                {step.marker && <strong class="marker">{step.marker}</strong>}
              </span>
              <span class="state">{step.state}</span>
            </li>
          ))}
        </ol>
      </div>
    </details>
  </Window>

  <Window id="wins" title="Latest posts - DragonByte Z Forums" icon="folder-new" labelledby="wins-title" class="forum-window wins-panel">
    <div class="th">
      <h2 id="wins-title">Latest verified wins</h2>
      <span class="th-aside">Proven at runtime or byte for byte</span>
    </div>
    <ol class="wins">
      {latest.map((item) => (
        <li class="topic">
          <Icon name="folder-new" class="topic-icon" />
          <details class="topic-body toggle">
            <summary><b>{item.title}</b></summary>
            <small>{item.summary}</small>
          </details>
        </li>
      ))}
    </ol>

    <details class="more">
      <summary>{rest.length} earlier logged results</summary>
      <div class="disclosure-body">
        <ol class="wins wins-archive">
          {rest.map((item) => (
            <li class="topic">
              <Icon name="folder" class="topic-icon" />
              <details class="topic-body toggle">
                <summary><b>{item.title}</b></summary>
                <small>{item.summary}</small>
              </details>
            </li>
          ))}
        </ol>
      </div>
    </details>
  </Window>
</div>
