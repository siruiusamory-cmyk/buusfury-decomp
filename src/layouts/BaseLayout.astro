---
import "../styles/global.css";
import { project } from "../data/project";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Webfoot SDK — Legacy of Goku Modding Progress",
  description = "Progress toward authoring playable Legacy of Goku content inside the original LOGII/Buu engine with Webfoot SDK.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1018" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={project.name} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
