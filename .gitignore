# Commercial ROM images
# `roms/` covers the directory; the bare `roms` covers a symlink or junction to
# it, which git reports as an untracked *file* and the directory pattern misses.
roms/
roms
*.gba
*.gb
*.gbc
*.sav
*.srm
*.mss
*.ss?
*.state

# Extracted/generated game data
extracted/
dump/
dumps/
stock/
exports/
*.bin
*.dump
*.raw

# Extracted graphics (TOOLKIT-010). Project extraction writes one indexed PNG
# per sprite payload; those pixels are the publisher's artwork, so they are
# project OUTPUT and are never committed, wherever a project happens to sit.
graphics/assets/
**/graphics/assets/

# Generated builds
build/
dist/
node_modules/
.astro/
*.egg-info/
*.spec

# External upstream repositories
extern/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# Local workflow-hook state
<tool-state>/

# Private agent/session workflow residue. These are local working notes, not
# project history, and must never reach the public repository.
/<working-notes>.md
/<workflow-state>/
/<working-notes>/

# local tool runtime state
<tool-state>/goals/
<tool-state>/workflow-steps/
<tool-state>/workflow-locks/

# Superseded one-off workflow migration prompt
/<working-notes>.txt

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local research scratch space. Ad-hoc probes and one-off scripts live here while
# a ticket is in flight; they are not deliverables and are never committed.
/scratchpad/
