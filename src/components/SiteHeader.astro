---
import { project } from "../data/project";
const base = import.meta.env.BASE_URL;
const repo = project.links.find((link) => link.url);
---

<header class="topbar">
  <div class="shell topbar-inner">
    <a class="brand" href={`${base}#status`}>
      <span class="brand-mark" aria-hidden="true">WF</span>
      <span class="brand-text">
        <strong>{project.name}</strong>
        <small>DragonByte Z</small>
      </span>
    </a>
    <nav class="topnav" aria-label="Primary">
      <ul>
        {project.nav.map((item) => <li><a href={`${base}#${item.href}`}>{item.label}</a></li>)}
      </ul>
    </nav>
    <p class="topbar-right">
      {repo && (
        <a class="repo-link" href={repo.url} rel="noopener">
          {repo.label} <span aria-hidden="true">↗</span>
        </a>
      )}
      <span class="topbar-status"><span class="dot" aria-hidden="true"></span>{project.developmentStatus}</span>
    </p>
  </div>
</header>
