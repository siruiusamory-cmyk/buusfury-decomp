+
+static void _processLog1ProbeArmCommand(struct GDBStub* stub, const char* message) {
+	struct GBALog1ReadProbeRequest request = {0};
+	uint32_t sequence = 0;
+	const char* cursor = message;
+	bool valid = _readLog1HexField(&cursor, ',', &sequence) &&
+	             _readLog1HexField(&cursor, ',', &request.target) &&
+	             _readLog1HexField(&cursor, ',', &request.loadEpoch) &&
+	             _readLog1HexField(&cursor, ',', &request.descriptor) &&
+	             _readLog1HexField(&cursor, ',', &request.factoryRaw) &&
+	             _readLog1HexField(&cursor, ',', &request.factoryFetch) &&
+	             _readLog1HexField(&cursor, ',', &request.matchKind);
+	request.sequence = sequence;
+	if (!valid || strncmp(cursor, GBA_LOG1_READ_PROBE_PROFILE_SHA256, 64) || cursor[64] != '#') {
+		strncpy(stub->outgoing, "E61", GDB_STUB_MAX_LINE - 4);
+		return;
+	}
+	if (stub->d.core->platform(stub->d.core) != mPLATFORM_GBA) {
+		strncpy(stub->outgoing, "E62", GDB_STUB_MAX_LINE - 4);
+		return;
+	}
+	struct GBA* gba = stub->d.core->board;
+	if (gba->log1ReadProbe.captured) {
+		strncpy(stub->outgoing, "E631", GDB_STUB_MAX_LINE - 4);
+		return;
+	}
+	if (request.sequence <= gba->log1ReadProbe.lastSequence) {
+		strncpy(stub->outgoing, "E632", GDB_STUB_MAX_LINE - 4);
+		return;
+	}
+	if (!request.loadEpoch) {
+		strncpy(stub->outgoing, "E633", GDB_STUB_MAX_LINE - 4);
+		return;
+	}
+	if (request.factoryRaw != 0x08007675 || request.factoryFetch != 0x08007674) {
+		strncpy(stub->outgoing, "E634", GDB_STUB_MAX_LINE - 4);
+		return;
+	}
+	if (request.matchKind > GBA_LOG1_READ_PROBE_ACCEPTED_X0C) {
+		strncpy(stub->outgoing, "E636", GDB_STUB_MAX_LINE - 4);
+		return;
+	}
+	if (request.target < BASE_WORKING_RAM || request.target > BASE_WORKING_RAM + SIZE_WORKING_RAM - 0x18) {
+		snprintf(stub->outgoing, GDB_STUB_MAX_LINE - 4, "E635%08X", request.target);
+		return;
+	}
+	if (!GBALog1ReadProbeArm(gba, &request)) {
+		strncpy(stub->outgoing, "E639", GDB_STUB_MAX_LINE - 4);
+		return;
+	}
+	strncpy(stub->outgoing, "OK", GDB_STUB_MAX_LINE - 4);
