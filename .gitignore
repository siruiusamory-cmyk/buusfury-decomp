# ---------------------------------------------------------------------------
# Commercial ROM images and save data - NEVER tracked.
# The user's legally dumped baserom lives outside version control. Everything
# in this file exists so that a stray `git add -A` cannot publish it.
# ---------------------------------------------------------------------------
*.gba
*.agb
*.bin.rom
baserom.gba
baserom.gba*
roms/
rom/
*.sav
*.sa1
*.ss0
*.ss1
*.ss2
*.ss3
*.ss4
*.ss5
*.ss6
*.ss7
*.ss8
*.ss9
*.sps
*.state
*.dump
*.extracted

# ---------------------------------------------------------------------------
# Build output. Never tracked; regenerated by scripts/build.ps1.
# ---------------------------------------------------------------------------
/build/
/out/
*.axf
*.o
*.obj
*.elf

# ---------------------------------------------------------------------------
# Fetched upstream reference material.
#
# 2genkidev/buusfury carries NO LICENSE (GitHub API reports "license": null),
# so its source and its ROM-derived BMP assets must not be committed here. It
# is fetched on demand into reference/ by scripts/fetch-reference.ps1 and stays
# ignored. See docs/REFERENCE_AUDIT.md.
#
# Other upstream checkouts (Arefu/Legacy, gbarecomp, DragonByteZ, ...) are
# research inputs, never vendored.
# ---------------------------------------------------------------------------
/reference/
/extern/
/vendor/

# ---------------------------------------------------------------------------
# Proprietary toolchain. ARM Developer Suite 1.2 is commercial software whose
# licence does not permit redistribution. It is installed locally and pointed
# at with ADS12_ROOT; its binaries must never enter this repository.
# ---------------------------------------------------------------------------
/toolchain/
/ADS/
*.lic
*.license
license.txt
LICENSE.txt
armasm
armasm.exe
armlink
armlink.exe
armcpp
armcpp.exe
armcc
armcc.exe
tcc
tcc.exe
tcpp
tcpp.exe
fromelf
fromelf.exe
armsd
armsd.exe
axd
axd.exe

# ---------------------------------------------------------------------------
# Scratch and editor noise.
# ---------------------------------------------------------------------------
/tmp/
/scratch/
*.tmp
*.temp
*.bak
*.orig
*.rej
*.log
*.swp
*~
Thumbs.db
desktop.ini
.vscode/
.idea/
