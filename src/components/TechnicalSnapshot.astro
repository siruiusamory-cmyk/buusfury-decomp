---
import { project } from "../data/project";
---

<section class="technical-panel panel" aria-labelledby="technical-title">
  <header class="section-header">
    <p class="eyebrow">OPTIONAL READOUT</p>
    <h2 id="technical-title">FOR THE CURIOUS</h2>
    <p>Measured facts from the current SDK model. This section is not required reading.</p>
  </header>
  <dl class="metric-grid">
    {project.metrics.map((metric) => (
      <div>
        <dt>{metric.label}</dt>
        <dd>{metric.value}</dd>
        {metric.explanation && <p>{metric.explanation}</p>}
      </div>
    ))}
  </dl>
</section>
