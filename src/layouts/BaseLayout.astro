---
import "../styles/global.css";
import { project, buildoutDone, buildoutTotal, buildoutPercent } from "../data/project";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${project.name} — ${project.currentPhase} progress`,
  description =
    `Webfoot SDK is a modding toolkit and desktop editor for the Webfoot Dragon Ball Z GBA games.` +
    ` DragonByte Z Buildout: ${buildoutDone} of ${buildoutTotal} editor capabilities shipped (${buildoutPercent}%).` +
    ` The authoring programme that built the toolkit is complete.`,
} = Astro.props;

// The canonical address and the social preview are derived from the site URL
// that `astro.config.mjs` receives as SITE_URL, so neither is written down a
// second time here. When no site is configured the two URL-derived tags are
// omitted rather than emitted relative or pointed at a build machine.
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const preview = site
  ? new URL(`${import.meta.env.BASE_URL}dbz-map-browser.png`, site).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2ccdf" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={project.name} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {preview && <meta property="og:image" content={preview} />}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
