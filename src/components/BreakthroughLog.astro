---
import { project } from "../data/project";
---

<section class="breakthrough-section" id="breakthroughs" aria-labelledby="breakthrough-title">
  <header class="section-header">
    <p class="eyebrow">BUILD LOG</p>
    <h2 id="breakthrough-title">RECENT BREAKTHROUGHS</h2>
    <p>Runtime evidence and authoring capability, not just theory.</p>
  </header>
  <div class="breakthrough-grid">
    {project.breakthroughs.map((item, index) => (
      <article class="breakthrough panel">
        <div class="log-index" aria-hidden="true">LOG/{String(index + 1).padStart(2, "0")}</div>
        <div>
          <div class="breakthrough-title-row">
            <h3>{item.title}</h3>
            {item.badge && <span class="badge">{item.badge}</span>}
          </div>
          {(item.date || item.commit) && (
            <p class="log-meta">{item.date}{item.date && item.commit ? " · " : ""}{item.commit}</p>
          )}
          <p>{item.summary}</p>
          {item.technical && (
            <details>
              <summary>Technical detail</summary>
              <p>{item.technical}</p>
            </details>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
