+		return;
+	}
+	struct GBALog1ReadProbeEvent event;
+	if (!GBALog1ReadProbeGetEvent(stub->d.core->board, &event)) {
+		stub->outgoing[0] = '\0';
+		return;
+	}
+	int offset = snprintf(stub->outgoing, GDB_STUB_MAX_LINE - 4,
+	    "LOG1E1,%016llX,%016llX,%08X,%08X,%08X,%08X,%08X,%08X,%08X,%08X,%08X,%08X,%08X,%08X",
+	    (unsigned long long) event.eventId,
+	    (unsigned long long) event.sequence,
+	    event.target,
+	    event.loadEpoch,
+	    event.descriptor,
+	    event.factoryRaw,
+	    event.factoryFetch,
+	    event.address,
+	    (uint32_t) event.relativeOffset,
+	    event.width,
+	    event.overlapStart,
+	    event.overlapEnd,
+	    event.instructionPc,
+	    event.cpsr);
+	for (unsigned i = 0; offset > 0 && i < 16; ++i) {
+		int written = snprintf(&stub->outgoing[offset], GDB_STUB_MAX_LINE - 4 - offset, ",%08X", event.gprs[i]);
+		if (written < 0 || written >= GDB_STUB_MAX_LINE - 4 - offset) {
+			stub->outgoing[0] = '\0';
+			return;
+		}
+		offset += written;
+	}
